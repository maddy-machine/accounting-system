generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  company   String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
}

model Transaction {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  description String
  amount      Float
  gstAmount   Float?
  type        String   // "INCOME" or "EXPENSE"
  category    String
  receiptUrl  String?
  createdAt   DateTime @default(now())
}

model Invoice {
  id          Int           @id @default(autoincrement())
  clientId    Int
  client      Client        @relation(fields: [clientId], references: [id])
  subTotal    Float         @default(0)
  gstAmount   Float         @default(0)
  discount    Float         @default(0)
  totalAmount Float         @default(0)
  status      String        // "DRAFT", "SENT", "PAID"
  dueDate     DateTime
  items       InvoiceItem[]
  createdAt   DateTime      @default(now())
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  isTaxable   Boolean  @default(true)
  createdAt   DateTime @default(now())
}
